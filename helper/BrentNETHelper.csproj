<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyName>BrentNETHelper</AssemblyName>
    <RootNamespace>BrentNETHelper</RootNamespace>

    <Product>BrentNET Client</Product>
    <Title>BrentNET Client</Title>
    <Description>BrentNET Client for resolving and managing BrentNET routes.</Description>
    <Company>BrentCorp Holdings Inc.</Company>
    <Copyright>Copyright © BrentCorp Holdings Inc. 2026</Copyright>

    <Version>0.2.11</Version>
    <AssemblyVersion>0.2.11.0</AssemblyVersion>
    <FileVersion>0.2.11.0</FileVersion>
    <InformationalVersion>0.2.11</InformationalVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="routes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>